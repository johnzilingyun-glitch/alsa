  const prefLang =  /^en/.test(selectedLang) ? 'en' :
      (selectedLang === 'zh-tw' || selectedLang === 'zh-hk') ? 'zh-Hant' : 'zh-Hans';
  switchLang(prefLang);
}

const switcher = document.querySelector('#switcher');
switcher.addEventListener('click', (e) => {
