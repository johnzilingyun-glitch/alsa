  <div id="container">
    <img src="https://s.yimg.com/rz/p/yahoo_homepage_en-US_s_f_p_bestfit_homepage_2x.png" alt="Yahoo Logo">
    <div id="switcher">
      <a data-lang="en" class="active" href='#'>English</a> |
